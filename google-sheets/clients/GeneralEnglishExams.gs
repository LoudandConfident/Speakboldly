 if(!/[.!?]["'”’)]?$/.test(text.trim()))flags.push('Punctuation: consider ending the final sentence with a full stop, question mark or exclamation mark.');
 const rules=[[/\b(he|she|it)\s+(have|do|go)\b/i,'Agreement: review he/she/it has, does or goes where the present simple is intended.'],[/\b(he|she|it)\s+are\b/i,'Agreement: review he/she/it is.'],[/\b(they|we|you)\s+is\b/i,'Agreement: review they/we/you are.'],[/\blook(?:ing)? forward to\s+(hear|meet|see)\b/i,'Form: after look forward to, use hearing, meeting or seeing.'],[/\bdiscuss\s+about\b/i,'Word choice: discuss usually takes a direct object; consider discuss the issue.'],[/\bdespite\s+(?:it|he|she|we|they|the\s+\w+)\s+(?:was|were|is|are|had)\b/i,'Linking: despite normally takes a noun or -ing phrase; although can introduce a full clause.'],[/\bmore\s+(?:better|easier|faster|cheaper)\b/i,'Comparison: normally use better/easier/faster/cheaper without more.'],[/\b(?:informations|advices|equipments)\b/i,'Vocabulary: information, advice and equipment are normally uncountable.']];
 for(const [pattern,note]of rules)if(pattern.test(text))flags.push(note);return flags;
}
