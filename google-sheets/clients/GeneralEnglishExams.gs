// ADD as a separate GeneralEnglishExams.gs file. Never replace Code.gs.
// See GENERAL-ENGLISH-EXAMS-SETUP.md. Existing exam attempts and signatures stay intact.
const SB_GE_HEADERS=['ID','Created at','Level','Status','Record JSON'];
const SB_GE_ACTIONS=['geExamSettings','geExamStart','geExamGet','geExamDraft','geExamSubmit','geExamOwnerSettings','geExamSaveSettings','geExamList','geExamReview','geExamRetry','geExamWord'];
function sbGeneralEnglishExamsHandleEvent(event){
 let p;try{p=JSON.parse(event?.postData?.contents||'null');}catch{return null;}
 if(p?.action==='studentSubmission')return sbStudentSubmission(p,event.postData.contents.length);
 if(!p||!SB_GE_ACTIONS.includes(p.action))return null;
 const json=x=>ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON),lock=LockService.getScriptLock();
 try{
  if(event.postData.contents.length>55000)throw Error('Your answers are too long. Please shorten them.');
  const owner=['geExamOwnerSettings','geExamSaveSettings','geExamList','geExamReview','geExamRetry','geExamWord'].includes(p.action);if(owner)sbRequireClientConnection(p);
  const ready=PropertiesService.getScriptProperties().getProperty('SB_GE_EXAMS_READY')==='true';
  if(p.action==='geExamSettings')return json({ok:true,ready,durationMinutes:45,levels:sbGeLevels(false),hubAccess:sbHubSnapshot(false)});
  if(!ready)throw Error('The instructor needs to activate the General English exam script.');
  if(p.action==='geExamOwnerSettings')return json({ok:true,levels:sbGeLevels(true),revision:sbHubSnapshot(true).revision,durationMinutes:45,recipient:'Submissions@speakboldly.space'});
  if(p.action==='geExamSaveSettings'){
   const level=Number(p.level);if(!SB_GE_CONTENT[level])throw Error('Upload this level’s examination before opening it.');
   return sbHubOwner({action:'saveHubAccessSetting',group:'exams:'+level,revision:p.revision,enabled:p.enabled,password:p.password},sbExamBook());
  }
  lock.waitLock(20000);const sheet=sbGeSheet(),rows=sbGeRows(sheet);
  if(p.action==='geExamList')return json({ok:true,attempts:rows.map(({record})=>sbGeView(record,true)).reverse()});
  if(p.action==='geExamReview'||p.action==='geExamRetry'||p.action==='geExamWord'){
   const saved=rows.find(r=>r.record.id===p.attemptId);if(!saved||!saved.record.submittedAt)throw Error('Choose a submitted examination.');const a=saved.record;
   if(p.action==='geExamWord'){const file=sbGeReviewWord(a);return json({ok:true,file:{name:file.getName(),mimeType:file.getContentType(),base64:Utilities.base64Encode(file.getBytes())}});}
   if(p.action==='geExamRetry'){
    if(a.mailStatus==='sent')return json({ok:true,attempt:sbGeView(a,true)});
    if(['sending','delivery_unknown'].includes(a.mailStatus)&&p.confirmCheckedSent!==true)throw Error('Check your sent mail before retrying uncertain delivery.');
    a.mailStatus='queued';sbGeSave(sheet,saved.index,a);sbGeNotify(sheet,saved.index,a);return json({ok:true,attempt:sbGeView(a,true)});
   }
   if(p.version!==a.version)throw Error('This review changed on another device. Refresh first.');const marks={};for(const [key,section]of Object.entries(SB_GE_CONTENT[a.level].sections)){const n=p.marks?.[key];if(typeof n!=='number'||!Number.isFinite(n)||n<0||n>section.marks)throw Error('Section '+key+' needs a mark between 0 and '+section.marks+'.');marks[key]=n;}
   const feedback=String(p.feedback||'').trim();if(feedback.length>6000)throw Error('Shorten the feedback.');const corrections=String(p.corrections||'').trim();if(corrections.length>12000)throw Error('Shorten the instructor corrections.');a.corrections=corrections;a.marks=marks;a.feedback=feedback;a.reviewedAt=new Date().toISOString();a.version++;a.status='Reviewed';sbGeSave(sheet,saved.index,a);return json({ok:true,attempt:sbGeView(a,true)});
  }
  const rawToken=String(p.accessToken||'');if(!/^[a-zA-Z0-9-]{64,160}$/.test(rawToken))throw Error('Your exam session is missing. Open the examination again.');
  const hash=sbExamHash(rawToken),saved=rows.find(r=>r.record.tokenHash===hash);
  if(p.action==='geExamStart'){
   const level=Number(p.level),name=String(p.name||'').trim();if(!SB_GE_CONTENT[level])throw Error('This level has not been uploaded yet.');if(!name||name.length>100)throw Error('Enter your name (up to 100 characters).');
   if(!sbHubAllowed('exams:'+level,(p.hubGrants||{})['exams:'+level]))throw Error('Enter this level’s current exam password first.');
   if(saved){if(saved.record.level!==level||saved.record.name!==name)throw Error('This exam session belongs to a different name or level.');sbGeExpire(sheet,saved.index,saved.record);return json({ok:true,attempt:sbGeView(saved.record)});}
   const now=Date.now(),record={id:Utilities.getUuid(),tokenHash:hash,name,level,version:1,status:'In progress',createdAt:new Date(now).toISOString(),deadline:now+45*60000,answers:sbGeAnswers({},level),submittedAt:'',mailStatus:'not_requested',mailError:'',marks:null,feedback:'',reviewedAt:''};
   if(rows.filter(r=>r.record.createdAt.slice(0,10)===record.createdAt.slice(0,10)).length>=300)throw Error('The daily examination limit has been reached. Contact your coach.');
   const index=sheet.getLastRow()+1;sbGeSave(sheet,index,record);return json({ok:true,attempt:sbGeView(record)});
  }
  if(!saved||saved.record.id!==String(p.attemptId||''))throw Error('This examination session could not be found. Reopen it.');
  const a=saved.record;sbGeExpire(sheet,saved.index,a);
  if((p.action==='geExamDraft'||p.action==='geExamSubmit')&&!a.submittedAt){
   if(p.version!==a.version)throw Error('Answers changed in another tab. Reopen this examination to load the saved version.');
   a.answers=sbGeAnswers(p.answers,a.level);a.version++;
   if(p.action==='geExamSubmit'){a.status='Submitted';a.submittedAt=new Date().toISOString();a.mailStatus='queued';}
   sbGeSave(sheet,saved.index,a);if(a.submittedAt)sbGeNotify(sheet,saved.index,a);
  }
  return json({ok:true,attempt:sbGeView(a)});
 }catch(error){return json({ok:false,error:String(error.message||error)});}finally{if(lock.hasLock())lock.releaseLock();}
}
function sbGeSheet(){const sheet=sbExamBook().getSheetByName('GE exam attempts');if(!sheet)throw Error('Run setupGeneralEnglishExams first.');return sheet;}
function sbGeRows(sheet){return sheet.getLastRow()>1?sheet.getRange(2,1,sheet.getLastRow()-1,5).getValues().map((r,i)=>({index:i+2,record:JSON.parse(String(r[4]))})):[];}
function sbGeSave(sheet,index,a){const raw=JSON.stringify(a);if(raw.length>45000)throw Error('Your answers exceed the saved record limit. Please shorten them.');sheet.getRange(index,1,1,5).setValues([[a.id,a.createdAt,a.level,a.status,raw]]);}
function sbGeView(a,owner){const view={id:a.id,name:a.name,level:a.level,status:a.status,version:a.version,createdAt:a.createdAt,deadline:a.deadline,serverNow:Date.now(),answers:a.answers,submittedAt:a.submittedAt,delivery:a.submittedAt?(a.mailStatus==='sent'?'sent':'pending'):null};if(owner)Object.assign(view,{mailStatus:a.mailStatus,mailError:a.mailError,marks:a.marks,feedback:a.feedback,corrections:a.corrections||'',reviewedAt:a.reviewedAt});return view;}
function sbGeLevels(owner){return Array.from({length:12},(_,i)=>{const level=i+1,entry=sbHubEntry('exams:'+level);return {level,uploaded:Boolean(SB_GE_CONTENT[level]),enabled:Boolean(SB_GE_CONTENT[level]&&entry.enabled),...(owner?{password:entry.password}:{})};});}
function sbGeAnswers(value,level){
 if(!value||typeof value!=='object'||Array.isArray(value))throw Error('Invalid examination answers.');const exam=SB_GE_CONTENT[level],out={};
 for(const [key,section]of Object.entries(exam.sections)){
  if(section.questions){out[key]={};const entries=value[key]||{};if(typeof entries!=='object'||Array.isArray(entries))throw Error('Invalid answers.');for(const [number,answer]of Object.entries(entries)){if(!/^[1-9]\d?$/.test(number)||Number(number)>section.questions.length)throw Error('Invalid question number.');const q=section.questions[Number(number)-1];if(q.options){if(!Number.isInteger(answer)||answer<0||answer>=q.options.length)throw Error('Invalid language option.');}else{if(typeof answer!=='string'||answer.length>(section.wordBank?100:1500))throw Error('Shorten the answer.');if(section.wordBank&&answer&&!section.wordBank.includes(answer))throw Error('Choose vocabulary from the word bank.');}out[key][number]=answer;}}
  else{const answer=value[key]||'';if(typeof answer!=='string'||answer.length>12000)throw Error('Shorten the writing response.');out[key]=answer;}
 }
 for(const key of ['plan',...(exam.version===4?['commentary']:[])]){const answer=value[key]||'';if(typeof answer!=='string'||answer.length>3000)throw Error('Shorten the commentary or planning notes.');out[key]=answer;}
 if(JSON.stringify(out).length>35000)throw Error('Your answers are too long. Please shorten them.');return out;
}
function sbGeExpire(sheet,index,a){if(!a.submittedAt&&Date.now()>=a.deadline){a.submittedAt=new Date().toISOString();a.status='Submitted';a.mailStatus='queued';a.version++;sbGeSave(sheet,index,a);sbGeNotify(sheet,index,a);}}
function sbGeNotify(sheet,index,a){
 if(a.mailStatus!=='queued')return;
 try{
  if(MailApp.getRemainingDailyQuota()<1){a.mailError='Email quota reached; the scheduled task will retry.';sbGeSave(sheet,index,a);return;}
  const exam=SB_GE_CONTENT[a.level],lines=['General English — Level '+a.level,'Name: '+a.name,'Exam ID: '+a.id,'Started (UTC): '+a.createdAt,'Deadline (UTC): '+new Date(a.deadline).toISOString(),'Submitted (UTC): '+a.submittedAt,'Duration: 45 minutes. Total: 100 marks.','Listening: coach reads the passage live.','All sections await instructor marking.',''];
  for(const [key,section]of Object.entries(exam.sections)){lines.push(section.title+' / '+section.marks+' marks',section.instruction);if(section.wordBank)lines.push('Word bank: '+section.wordBank.join(' / '));if(section.passage)lines.push(section.passage);if(section.questions)for(const q of section.questions){const answer=a.answers[key]?.[q.number];lines.push(q.number+'. '+q.question+(q.options?' ('+q.options.join(' / ')+')':''),'Answer: '+(q.options?(answer===undefined?'(No answer)':q.options[answer]):answer||'(No answer)'));}else lines.push('Target: '+section.wordMin+'–'+section.wordMax+' words','Planning notes: '+(a.answers.plan||'(None)'),'Writing: '+(a.answers[key]||'(No answer)'));if(section.commentaryMin!==undefined)lines.push('Commentary target: '+section.commentaryMin+'–'+section.commentaryMax+' words','Commentary: '+(a.answers.commentary||'(No answer)'));lines.push('');}
  lines.push('English Language Coaching','© 2026 Founded by Mira Nasser Louis.');
  const word=sbGeReviewWord(a);lines.push(...sbGeReviewLines(a));
  a.mailStatus='sending';a.mailError='';sbGeSave(sheet,index,a);
  MailApp.sendEmail({to:'Submissions@speakboldly.space',subject:'General English exam — Level '+a.level+' — '+a.name.replace(/[\r\n]/g,' '),body:lines.join('\n'),name:'Speak Boldly',attachments:[word]});
  a.mailStatus='sent';sbGeSave(sheet,index,a);
 }catch(error){a.mailStatus=a.mailStatus==='sending'?'delivery_unknown':'failed';a.mailError=String(error.message||error).slice(0,1000);sbGeSave(sheet,index,a);}
}
function sbGeExpireAttempts(){const lock=LockService.getScriptLock();if(!lock.tryLock(1000))return;try{const sheet=sbGeSheet();let count=0;for(const saved of sbGeRows(sheet)){if(count>=25)break;const a=saved.record;if(!a.submittedAt&&Date.now()>=a.deadline){sbGeExpire(sheet,saved.index,a);count++;}else if(a.submittedAt&&a.mailStatus==='queued'){sbGeNotify(sheet,saved.index,a);count++;}}}finally{lock.releaseLock();}}
function setupGeneralEnglishExams(){
 if(typeof sbHubAllowed!=='function'||typeof sbRequireClientConnection!=='function')throw Error('Keep the existing Clients Code.gs and password functions.');
 const book=sbExamBook();let sheet=book.getSheetByName('GE exam attempts');if(!sheet)sheet=book.insertSheet('GE exam attempts');if(!sheet.getLastRow()){sheet.appendRow(SB_GE_HEADERS);sheet.setFrozenRows(1);}else if(JSON.stringify(sheet.getRange(1,1,1,5).getValues()[0])!==JSON.stringify(SB_GE_HEADERS))throw Error('GE exam headers differ. Existing data was not replaced.');
 const props=PropertiesService.getScriptProperties(),state=sbHubState();if(props.getProperty('SB_GE_EXAMS_READY')!=='true'){state.entries=state.entries||{};for(const level of Object.keys(SB_GE_CONTENT)){const key='exams:'+level;state.entries[key]={...(state.entries[key]||{}),enabled:true};}state.revision=Utilities.getUuid();props.setProperty('SB_HUB_ACCESS_V1',JSON.stringify(state));}
 if(!ScriptApp.getProjectTriggers().some(t=>t.getHandlerFunction()==='sbGeExpireAttempts'))ScriptApp.newTrigger('sbGeExpireAttempts').timeBased().everyMinutes(1).create();
 MailApp.getRemainingDailyQuota();props.setProperty('SB_GE_EXAMS_READY','true');console.log('General English exams ready: Levels 1–12, 45 minutes, live listening. Existing attempts/client/calendar rows were not changed. Deploy a New version of the existing web app.');
}

