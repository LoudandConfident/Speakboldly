function sbStudentSubmissionFiles(input){
 if(input===undefined)return[];if(!Array.isArray(input)||input.length>10)throw Error('Attach up to 10 files.');let total=0;
 return input.map(value=>{if(!value||typeof value!=='object')throw Error('Invalid attachment.');const name=String(value.name||''),ext=name.split('.').pop().toLowerCase(),mimeType=SB_STUDENT_SUB_TYPES[ext],encoded=String(value.base64||'');
  if(!name||name.length>120||/[\r\n\\/]/.test(name)||!mimeType||value.mimeType!==mimeType||!encoded||encoded.length>6666668||! /^[A-Za-z0-9+/]*={0,2}$/.test(encoded))throw Error('Use supported files up to 5 MB each.');
  const bytes=Utilities.base64Decode(encoded);if(!bytes.length||bytes.length>5000000)throw Error('Each attachment must be between 1 byte and 5 MB.');total+=bytes.length;if(total>15000000)throw Error('Keep all attachments within 15 MB total.');
  const first=bytes.slice(0,12).map(b=>b&255),starts=expected=>expected.every((n,i)=>first[i]===n);
  if((ext==='pdf'&&!starts([37,80,68,70,45]))||(['jpg','jpeg'].includes(ext)&&!starts([255,216,255]))||(ext==='png'&&!starts([137,80,78,71,13,10,26,10]))||(ext==='gif'&&!starts([71,73,70,56]))||(ext==='webp'&&(!starts([82,73,70,70])||String.fromCharCode(...first.slice(8,12))!=='WEBP')))throw Error('The file contents do not match its format: '+name);
  return{name,mimeType,bytes};});
}
