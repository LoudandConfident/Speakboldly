// Only the new rewards routes use these functions and tables.
const SB_REWARD_ACTIONS=['rewardsSettings','rewardClaim','rewardReferral','rewardList','rewardApprove','rewardSend','rewardReject','rewardRedeem'];
function sbRewardsHandleEvent(event){
 let data;try{data=JSON.parse(event?.postData?.contents||'null');}catch{return null;}
 if(!data||!SB_REWARD_ACTIONS.includes(data.action))return null;
 const json=value=>ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON);
 const lock=LockService.getScriptLock();
 try{if(JSON.stringify(data).length>3000000)throw Error('The picture is too large.');if(data.website)throw Error('Invalid request.');
  if(data.action==='rewardsSettings')return json({ok:true,enabled:PropertiesService.getScriptProperties().getProperty('SB_REWARDS_ENABLED')==='true',percent:10});
  const owner=['rewardList','rewardApprove','rewardSend','rewardReject','rewardRedeem'].includes(data.action);if(!owner&&PropertiesService.getScriptProperties().getProperty('SB_REWARDS_ENABLED')!=='true')throw Error('Rewards are not available yet.');if(owner)sbRewardAuthorize(data);
  lock.waitLock(20000);const book=sbRewardBook();let result;
  if(data.action==='rewardClaim')result=sbRewardCreateClaim(book,data);
  else if(data.action==='rewardReferral')result=sbRewardCreateReferral(book,data);
  else if(data.action==='rewardList')result={claims:sbRewardRows(book,'Reward claims').map(x=>x.data),referrals:sbRewardRows(book,'Reward referrals').map(x=>({code:x.data.code,name:x.data.name,email:x.data.email,createdAt:x.data.createdAt}))};
  else result=sbRewardOwnerAction(book,data);
  return json({ok:true,...result});
 }catch(error){return json({ok:false,error:String(error.message||error)});}finally{if(lock.hasLock())lock.releaseLock();}
}
function setupRewards(){
 const book=sbRewardBook();sbRewardSheet(book,'Reward claims');sbRewardSheet(book,'Reward referrals');
 if(typeof sbVerifiedFrom!=='function'||typeof sbSendDomainEmail!=='function')throw Error('Keep the existing domain email functions in Code.gs.');
 sbVerifiedFrom('billing@speakboldly.space');MailApp.getRemainingDailyQuota();
 PropertiesService.getScriptProperties().setProperty('SB_REWARDS_ENABLED','true');
 console.log('Rewards ready. Add the small routing block inside doPost and deploy a New version of the existing web app. Existing client/session rows were not changed.');
}
function sbRewardBook(){const id=PropertiesService.getScriptProperties().getProperty('CLIENT_SHEET_ID');if(!id)throw Error('Keep the existing Clients project and its CLIENT_SHEET_ID property.');return SpreadsheetApp.openById(id);}
function sbRewardAuthorize(data){const key=PropertiesService.getScriptProperties().getProperty('CLIENT_SYNC_KEY');if(!key||data.key!==key)throw Error('Incorrect connection key.');}
function sbRewardSheet(book,name){let sheet=book.getSheetByName(name);if(!sheet){sheet=book.insertSheet(name);sheet.appendRow(['ID','Created at','Status','Email','Record JSON']);sheet.setFrozenRows(1);}return sheet;}
function sbRewardRows(book,name){const sheet=sbRewardSheet(book,name);return sheet.getLastRow()>1?sheet.getRange(2,1,sheet.getLastRow()-1,5).getValues().map((r,i)=>({row:i+2,data:JSON.parse(String(r[4]))})):[];}
function sbRewardWrite(book,name,record,row){const sheet=sbRewardSheet(book,name),values=[record.id,record.createdAt,record.status||'active',record.email,JSON.stringify(record)].map(v=>/^[=+\-@\t\r]/.test(String(v))?"'"+v:v);const target=sheet.getRange(row||sheet.getLastRow()+1,1,1,5);target.setNumberFormat('@');target.setValues([values]);}
function sbRewardText(value,max,required){const text=String(value??'').trim();if(text.length>max||(required&&!text))throw Error('Please complete the required reward details.');return text;}
function sbRewardIdentity(data){const name=sbRewardText(data.name,100,true),email=sbRewardText(data.email,254,true).toLowerCase();if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)||/[\r\n<>,;]/.test(email))throw Error('Enter a valid email address.');return {name,email};}
function sbRewardClients(book){const sheet=book.getSheetByName('Clients');if(!sheet||sheet.getLastRow()<2)return [];return sheet.getRange(2,1,sheet.getLastRow()-1,15).getValues().filter(r=>r[0]).map(r=>({id:String(r[0]),name:String(r[1]).replace(/^'/,''),email:String(r[2]).trim().toLowerCase(),level:String(r[4]),payment:String(r[5]),amountPaid:Number(r[6]||0),history:r[10]?JSON.parse(String(r[10])):[]}));}
function sbRewardGuard(book,email){const claims=sbRewardRows(book,'Reward claims').map(x=>x.data),referrals=sbRewardRows(book,'Reward referrals').map(x=>x.data),cutoff=Date.now()-86400000;if([...claims,...referrals].filter(x=>Date.parse(x.createdAt)>cutoff).length>=100)throw Error('Rewards are busy today. Please try again tomorrow.');if(claims.filter(x=>x.email===email&&Date.parse(x.createdAt)>cutoff).length>=3)throw Error('Your reward requests are already recorded. Please wait for your coach.');}
function sbRewardSource(value){const url=sbRewardText(value,700,true);if(!/^https:\/\/speakboldly\.space\/(?:blog\/|motivation\/|learn\/daily-quotes\/|programs\/|$)/i.test(url))throw Error('Choose a public Speak Boldly blog, motivation or program link.');return url;}
function sbRewardProof(data){const link=sbRewardText(data.proofUrl,1000,false);if(link&&!/^https:\/\/[^\s<>]+$/i.test(link))throw Error('Enter a valid shared-post link.');const image=data.proofImage;if(!link&&!image)throw Error('Add a shared-post link or a screenshot for your coach to check.');if(!image)return {proofUrl:link};const mime=String(image.mimeType||''),encoded=String(image.base64||'');if(!['image/jpeg','image/png'].includes(mime)||encoded.length>2800000||! /^[A-Za-z0-9+/]*={0,2}$/.test(encoded))throw Error('Use a JPG or PNG screenshot up to 2 MB.');const bytes=Utilities.base64Decode(encoded),h=bytes.slice(0,8).map(x=>x&255);if(bytes.length>2000000||!(mime==='image/jpeg'?h[0]===255&&h[1]===216&&h[2]===255:h[0]===137&&h[1]===80&&h[2]===78&&h[3]===71))throw Error('The screenshot is not a valid JPG or PNG.');const props=PropertiesService.getScriptProperties();let id=props.getProperty('SB_REWARD_PROOF_FOLDER'),folder;if(id)folder=DriveApp.getFolderById(id);else{folder=DriveApp.createFolder('Speak Boldly — private reward proofs');props.setProperty('SB_REWARD_PROOF_FOLDER',folder.getId());}const file=folder.createFile(Utilities.newBlob(bytes,mime,'reward-proof-'+Utilities.getUuid()+(mime==='image/png'?'.png':'.jpg')));file.setSharing(DriveApp.Access.PRIVATE,DriveApp.Permission.NONE);return {proofUrl:link,proofFileUrl:file.getUrl()};}
function sbRewardCreateClaim(book,data){
 const identity=sbRewardIdentity(data),requestId=sbRewardText(data.requestId,100,true);if(!/^[a-zA-Z0-9-]{16,100}$/.test(requestId))throw Error('Refresh this form and try again.');const records=sbRewardRows(book,'Reward claims');if(records.some(x=>x.data.requestId===requestId))return {status:'pending',claimId:records.find(x=>x.data.requestId===requestId).data.id};
 sbRewardGuard(book,identity.email);const kind=data.kind;if(!['share','refer'].includes(kind))throw Error('Choose Share & Save or Refer & Save.');let details;
 if(kind==='share')details={source:sbRewardSource(data.source),channel:sbRewardText(data.channel,80,true),...sbRewardProof(data)};
 else{const code=sbRewardText(data.referralCode,50,true),referral=sbRewardRows(book,'Reward referrals').find(x=>x.data.code===code&&x.data.email===identity.email);if(!referral)throw Error('Use the referral code emailed to your own address.');const friendEmail=sbRewardText(data.friendEmail,254,true).toLowerCase();if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(friendEmail)||friendEmail===identity.email)throw Error('Enter the referred learner’s email address.');details={referralCode:code,friendEmail};}
 const record={id:Utilities.getUuid(),createdAt:new Date().toISOString(),requestId,status:'pending',kind,...identity,...details};sbRewardWrite(book,'Reward claims',record);return {status:'pending',claimId:record.id};
}
function sbRewardSendMail(to,subject,body,htmlBody,attachments,inlineImages){if(MailApp.getRemainingDailyQuota()<1)throw Error('Email quota reached. Please retry tomorrow.');const from=sbVerifiedFrom('billing@speakboldly.space');sbSendDomainEmail({to,subject,body,htmlBody,name:'Speak Boldly',replyTo:'billing@speakboldly.space',...(attachments?{attachments}:{}),...(inlineImages?{inlineImages}:{})},from);}
function sbRewardEscape(value){return String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function sbRewardCreateReferral(book,data){
 const identity=sbRewardIdentity(data),rows=sbRewardRows(book,'Reward referrals');let saved=rows.find(x=>x.data.email===identity.email);if(saved&&saved.data.mailStatus==='sent')return {status:'sent',referralUrl:saved.data.url,referralCode:saved.data.code};
 if(saved&&['sending','check_sent'].includes(saved.data.mailStatus))throw Error('Your referral email is being processed. Ask your coach if it does not arrive.');
 sbRewardGuard(book,identity.email);let record=saved?.data;if(!record){const code='SBREF-'+Utilities.getUuid().replace(/-/g,'').slice(0,16).toUpperCase();record={id:Utilities.getUuid(),createdAt:new Date().toISOString(),...identity,code,url:'https://speakboldly.space/programs/?ref='+code,clientIdsAtCreation:sbRewardClients(book).map(c=>c.id)};sbRewardWrite(book,'Reward referrals',record);saved=sbRewardRows(book,'Reward referrals').find(x=>x.data.id===record.id);}
 if(rows.filter(x=>Date.parse(x.data.createdAt)>Date.now()-86400000&&x.data.mailStatus==='sent').length>=20||MailApp.getRemainingDailyQuota()<20)throw Error('Referral email is temporarily unavailable. Please try again tomorrow.');
 record.mailStatus='sending';sbRewardWrite(book,'Reward referrals',record,saved.row);
 try{sbRewardSendMail(record.email,'Your Speak Boldly referral link','Hi '+record.name+',\n\nShare your personal referral link: '+record.url+'\n\nWhen a new learner you refer pays for their first round, submit their email with your referral code '+record.code+' through Refer & Save. Your coach will confirm eligibility, then email your personalised 10% voucher.\n\nCurrent students: next round. New students: first round. One voucher per eligible round; no stacking.\n\nEnglish Language Coaching\n© 2026 Founded by Mira Nasser Louis.','<p>Hi '+sbRewardEscape(record.name)+',</p><p>Your referral link: <a href="'+record.url+'">'+record.url+'</a></p><p>Referral code: <strong>'+record.code+'</strong></p><p>Your reward qualifies after a new learner pays for their first round. Submit their email through Refer &amp; Save so your coach can confirm it.</p><p>English Language Coaching<br>© 2026 Founded by Mira Nasser Louis.</p>');record.mailStatus='sent';sbRewardWrite(book,'Reward referrals',record,saved.row);return {status:'sent',referralUrl:record.url,referralCode:record.code};}catch(error){record.mailStatus='check_sent';sbRewardWrite(book,'Reward referrals',record,saved.row);throw Error('The email could not be confirmed. Ask your coach to check Sent mail before retrying.');}
}
function sbRewardOwnerAction(book,data){
 const rows=sbRewardRows(book,'Reward claims'),entry=rows.find(x=>x.data.id===data.claimId);if(!entry)throw Error('Choose an existing reward claim.');const r=entry.data,save=()=>sbRewardWrite(book,'Reward claims',r,entry.row),clients=sbRewardClients(book);
 if(data.action==='rewardReject'){if(r.voucher)throw Error('An approved voucher cannot be rejected here.');r.status='declined';r.note=sbRewardText(data.note,500,true);save();return {status:r.status};}
 if(data.action==='rewardApprove'){
  if(r.voucher)return {status:r.status,voucher:r.voucher};if(r.status!=='pending'||data.confirmed!==true)throw Error('Confirm that this claim qualifies before approving.');
  if(rows.some(x=>x.data.email===r.email&&x.data.id!==r.id&&x.data.voucher&&x.data.status!=='used'))throw Error('This person already has an unused voucher. Offers cannot be combined.');
  if(r.kind==='refer'){const referral=sbRewardRows(book,'Reward referrals').find(x=>x.data.code===r.referralCode),friend=clients.find(c=>c.email===r.friendEmail);if(!referral||!friend||referral.data.clientIdsAtCreation.includes(friend.id)||friend.payment!=='Paid'||friend.amountPaid<=0||(friend.history||[]).some(h=>h.reason==='advanced'))throw Error('The referred learner must be a new client with their first round marked Paid.');if(rows.some(x=>x.data.id!==r.id&&x.data.friendId===friend.id&&x.data.voucher))throw Error('This learner has already qualified another referral reward.');r.friendId=friend.id;}
  const client=clients.find(c=>c.email===r.email);r.voucher={code:'SB10-'+Utilities.getUuid().replace(/-/g,'').toUpperCase(),name:client?.name||r.name,email:r.email,percent:10,issuedAt:new Date().toISOString(),issuedDate:Utilities.formatDate(new Date(),'Africa/Cairo','dd MMM yyyy'),eligibility:client?'next':'first',clientId:client?.id||null,roundSnapshot:client?JSON.stringify([client.level,client.history.length]):null};r.status='approved';save();return {status:r.status,voucher:r.voucher};
 }
 if(data.action==='rewardSend'){
  if(!r.voucher||r.status==='used')throw Error('Approve the claim before sending its voucher.');const requestId=sbRewardText(data.requestId,100,true);if(requestId===r.mailRequestId){if(r.status==='issued')return {status:'sent',voucher:r.voucher};throw Error('Check Sent mail before retrying this send.');}if(['sending','send_error','issued'].includes(r.status)&&data.confirmResend!==true)throw Error('Confirm a resend after checking Sent mail.');
  const encoded=String(data.image||'');if(encoded.length>2800000||! /^[A-Za-z0-9+/]*={0,2}$/.test(encoded))throw Error('Use a voucher image under 2 MB.');const bytes=Utilities.base64Decode(encoded);if(!bytes.length||bytes.length>2000000||(bytes[0]&255)!==255||(bytes[1]&255)!==216)throw Error('The voucher image must be JPEG.');const v=r.voucher,blob=Utilities.newBlob(bytes,'image/jpeg','Speak-Boldly-'+v.code+'.jpg');
  r.mailRequestId=requestId;r.status='sending';save();try{sbRewardSendMail(v.email,'Your personal 10% Speak Boldly voucher','Hi '+v.name+',\n\nYour personal voucher is attached.\n\n10% off your '+(v.eligibility==='next'?'next':'first')+' course round.\nIssued: '+v.issuedDate+'\nVoucher code: '+v.code+'\nRegistered email: '+v.email+'\n\nOne use. Named recipient only. Do not share this voucher. Offers cannot be combined. Your coach checks the code and eligible round when you redeem.\n\nEnglish Language Coaching\n© 2026 Founded by Mira Nasser Louis.','<p>Hi '+sbRewardEscape(v.name)+',</p><p>Your personal <strong>10% off your '+(v.eligibility==='next'?'next':'first')+' round</strong> voucher is attached.</p><img src="cid:voucher" width="600" alt="Your personalised Speak Boldly discount voucher" style="max-width:100%;height:auto"><p>Registered email: '+sbRewardEscape(v.email)+'<br>Issued: '+v.issuedDate+'<br>Code: '+v.code+'</p><p>One use. Named recipient only. Do not share this voucher. Offers cannot be combined.</p><p>English Language Coaching<br>© 2026 Founded by Mira Nasser Louis.</p>',[blob],{voucher:blob});r.status='issued';r.sentAt=new Date().toISOString();save();return {status:'sent',voucher:v};}catch(error){r.status='send_error';r.mailError=String(error.message||error);save();throw Error('Email could not be confirmed. Check Sent mail before resending.');}
 }
 if(data.action==='rewardRedeem'){
  if(r.status!=='issued')throw Error('This voucher must be issued and unused.');const v=r.voucher,client=clients.find(c=>c.id===data.clientId);if(!client||client.email!==v.email||(v.clientId&&client.id!==v.clientId))throw Error('This voucher belongs to a different registered learner.');if(v.eligibility==='first'&&(client.history||[]).some(h=>h.reason==='advanced'))throw Error('This voucher applies to a first round only.');if(data.confirmEligibleRound!==true)throw Error('Confirm this is the eligible '+v.eligibility+' round, not an existing paid round.');const round=sbRewardText(data.roundReference,120,true),fee=Number(data.fee);if(!Number.isFinite(fee)||fee<=0||fee>1000000)throw Error('Enter the eligible round’s tuition fee.');if(rows.some(x=>x.data.status==='used'&&x.data.voucher?.email===v.email&&x.data.redemption?.roundReference===round))throw Error('A voucher was already used for this round.');r.status='used';r.redemption={clientId:client.id,roundReference:round,usedAt:new Date().toISOString(),fee,discount:Math.round(fee*10)/100,total:Math.round(fee*90)/100};save();return {status:'used',redemption:r.redemption};
 }
 throw Error('Invalid rewards action.');
}
